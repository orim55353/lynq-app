{
  "expo": {
    "name": "Lynq",
    "slug": "lynq",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "experiments": {
      "reactCompiler": true
    },
    "scheme": "com.lynq.app",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lynq.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Lynq uses your location to show jobs near you."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "1ef62c07-4667-4445-8bbf-2bfc49b886a1"
      }
    },
    "owner": "lynq-jobs",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/1ef62c07-4667-4445-8bbf-2bfc49b886a1"
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "expo-font"
    ]
  }
}
