rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Jobs: read for authenticated users (or allow read for all if you prefer); write admin only via backend
    match /jobs/{jobId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Users: each user can read and write only their own document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Saved jobs subcollection: same user only
      match /savedJobs/{jobId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Chats subcollection (phase 2): same user only
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }
    }
  }
}
