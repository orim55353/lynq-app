{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "lib": [
      "ESNext"
    ],
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "react",
      "react-native",
      "node"
    ]
  },
  "include": [
    "App.tsx",
    "src"
  ],
  "exclude": [
    "figma",
    "node_modules"
  ],
  "extends": "expo/tsconfig.base"
}
